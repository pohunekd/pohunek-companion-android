#!/usr/bin/env python3
"""Draws the scripted touches into a raw screen recording.

  scripts/touch-overlay RAW GESTURES OUT [options]

The emulator does not render a touch indicator into screenshots or recordings, so
the scene's own gestures are composited into the clip: a white ring with a soft dark
edge appears at a tap's point during the dwell and expands and fades on release; a
swipe is a ring that follows the scripted path and fades at its end.

GESTURES is the log scripts/capture-video writes: a line `REC<TAB>before<TAB>after` with the
device uptime read before the recording was started and after it had started, and one line per gesture
`G<TAB>tap|swipe<TAB>device-uptime-when-it-ended<TAB>duration-ms<TAB>x1<TAB>y1<TAB>x2<TAB>y2`
(device uptime in seconds). The recording's clock and the device uptime differ by an unknown lag, so each
gesture is anchored in the clip itself (see anchor()): the uptime only bounds a window in which the
gesture's first visible change must lie, and the command fails when a gesture has none.

OUT is the constant-rate recording with the rings, on RAW's time axis. Needs python3
with numpy, and ffmpeg.
"""
import argparse
import re
import statistics
import struct
import subprocess
import sys
import zlib

import numpy as np


def die(message):
    print(f"touch-overlay: {message}", file=sys.stderr)
    sys.exit(1)


def png_bytes(rgba):
    height, width, _ = rgba.shape
    raw = b"".join(b"\x00" + rgba[y].tobytes() for y in range(height))

    def chunk(kind, data):
        body = kind + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)

    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))


def ring_image(diameter, thickness, edge, opacity, edge_opacity):
    """Straight-alpha RGBA of a white ring with a soft dark edge on both sides."""
    size = int(diameter + 2 * edge + 4)
    centre = (size - 1) / 2
    y, x = np.mgrid[0:size, 0:size]
    distance = np.abs(np.hypot(x - centre, y - centre) - diameter / 2)
    core = np.clip(thickness / 2 + 0.5 - distance, 0, 1) * opacity
    shade = np.clip((thickness / 2 + edge - distance) / edge, 0, 1) * edge_opacity
    alpha = core + shade * (1 - core)
    safe = np.where(alpha > 0, alpha, 1)
    colour = (255 * core + 24 * shade * (1 - core)) / safe
    rgba = np.zeros((size, size, 4), np.uint8)
    rgba[..., 0] = rgba[..., 1] = rgba[..., 2] = np.clip(colour, 0, 255).astype(np.uint8)
    rgba[..., 3] = np.clip(alpha * 255, 0, 255).astype(np.uint8)
    return rgba


def frame_series(path, scale):
    """Per frame of RAW: its time in ms and a small grayscale copy (frames only exist where the screen changed)."""
    probe = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height",
                            "-of", "csv=p=0", path], capture_output=True, text=True, check=True).stdout.strip().split(",")
    width, height = int(probe[0]) // scale, int(probe[1]) // scale
    times = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "frame=pts_time",
                            "-of", "csv=p=0", path], capture_output=True, text=True, check=True).stdout.split()
    frames = subprocess.run(["ffmpeg", "-v", "fatal", "-nostdin", "-i", path, "-vf",
                             f"scale={width}:{height}:flags=area,format=gray,setpts=N/30/TB", "-fps_mode", "passthrough",
                             "-f", "rawvideo", "-"], capture_output=True, check=True).stdout
    frames = np.frombuffer(frames, np.uint8).reshape(-1, height, width).astype(np.float32)
    times = [float(t) * 1000 for t in times][:len(frames)]
    return times, frames[:len(times)]


def read_log(path):
    start, started, gestures = None, None, []
    with open(path) as handle:
        for line in handle:
            fields = line.rstrip("\n").split("\t")
            if fields[0] == "REC":
                start = float(fields[1])
                started = float(fields[2]) if len(fields) > 2 else start
            elif fields[0] == "G":
                kind, ended, duration, x1, y1, x2, y2 = fields[1:]
                gestures.append({"kind": kind, "ended": float(ended), "ms": float(duration),
                                 "x1": float(x1), "y1": float(y1), "x2": float(x2), "y2": float(y2)})
    if start is None or not gestures:
        die(f"{path} needs a REC line and at least one gesture")
    return start, started, gestures


def anchor(start, started, gestures, times, frames, args):
    """Finds, in the clip itself, the frame at which each gesture starts to show.

    The device clock only gives a coarse window (the lag between the clock and the recording is not
    known, but the first frame lies between `start` and `started` + --start-slack-ms; later gestures
    use the lag of the one before, within --onset-window-ms). In that window:
      press   a tap's pressed state: the frame in which a box around the tap point changes and the rest
              of the screen does not (the finger lands at that frame)
      result  a tap without a pressed state: the first frame in which the screen changes after the finger
              lifts (the finger landed --dwell earlier, the screen reacts --render-ms after the lift)
      motion  a swipe: the first frame in which the screen changes after the finger lands
    Fails when a gesture has no such frame in its window.
    Returns per gesture the time in ms at which the finger lands and lifts, with the rule that was used.
    """
    scale = args.scale
    half = max(1, int(args.box_px / scale / 2))
    height, width = frames.shape[1:]
    diffs = np.abs(np.diff(frames, axis=0))
    totals = diffs.sum(axis=(1, 2))
    solved, lag = [], None
    for i, g in enumerate(gestures):
        # Where the finger lands on the device clock, relative to the first reading.
        landed = (g["ended"] - start) * 1000 - g["ms"]
        if lag is None:
            lo, hi = landed - ((started - start) * 1000 + args.start_slack_ms) - args.onset_window_ms, landed + args.onset_window_ms
        else:
            lo, hi = landed - lag - args.onset_window_ms, landed - lag + args.onset_window_ms
        cx, cy = int(g["x1"] / scale), int(g["y1"] / scale)
        x0, x1, y0, y1 = max(0, cx - half), min(width, cx + half), max(0, cy - half), min(height, cy + half)
        box = diffs[:, y0:y1, x0:x1].mean(axis=(1, 2))
        rest = (totals - diffs[:, y0:y1, x0:x1].sum(axis=(1, 2))) / (width * height - (x1 - x0) * (y1 - y0))
        pick, rule = None, None
        if g["kind"] == "tap":
            for k in range(len(diffs)):
                # With a lag known from an earlier gesture the window is narrow, so a press may also change
                # the rest of the screen (a wide list row highlights beyond the box).
                if lo <= times[k + 1] <= hi and box[k] >= args.box_threshold and (lag is not None or rest[k] <= args.rest_threshold):
                    pick, rule = k + 1, "press"
                    break
            if pick is None:
                for k in range(len(diffs)):
                    if lo + g["ms"] <= times[k + 1] <= hi + g["ms"] + args.render_ms and rest[k] >= args.change_threshold:
                        pick, rule = k + 1, "result"
                        break
        else:
            for k in range(len(diffs)):
                if lo <= times[k + 1] <= hi and (rest[k] + box[k]) >= args.change_threshold:
                    pick, rule = k + 1, "motion"
                    break
        if pick is None:
            die(f"gesture {i + 1} ({g['kind']} at {g['x1']:.0f},{g['y1']:.0f}) shows no onset between "
                f"{lo:.0f} and {hi:.0f} ms of the clip; box change {[round(float(v), 2) for v in box[(np.array(times[1:]) >= lo) & (np.array(times[1:]) <= hi)][:12]]}, "
                f"rest change {[round(float(v), 2) for v in rest[(np.array(times[1:]) >= lo) & (np.array(times[1:]) <= hi)][:12]]}")
        onset = times[pick]
        down = onset if rule in ("press", "motion") else onset - args.render_ms - g["ms"]
        solved.append({"rule": rule, "down": down, "up": down + g["ms"], "onset": onset, "predicted": landed,
                       "box": float(box[pick - 1]), "rest": float(rest[pick - 1])})
        lag = landed - down
        print(f"touch-overlay: gesture {i + 1} {g['kind']} ({g['x1']:.0f},{g['y1']:.0f}) rule={rule} down={down:.0f} ms "
              f"onset={onset:.0f} ms clock-lag={lag:.0f} ms box={box[pick - 1]:.2f} rest={rest[pick - 1]:.2f}", file=sys.stderr)
    return solved


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("raw")
    parser.add_argument("gestures")
    parser.add_argument("out")
    for name, kind in (("fps", int), ("render-ms", float),
                       ("start-slack-ms", float), ("onset-window-ms", float), ("box-px", int),
                       ("scale", int), ("box-threshold", float), ("rest-threshold", float), ("change-threshold", float),
                       ("ring-px", int), ("ring-thickness-px", int), ("edge-px", int), ("opacity", float),
                       ("edge-opacity", float), ("release-scale", float), ("fade-in-ms", float), ("release-ms", float)):
        parser.add_argument("--" + name, type=kind, required=True)
    parser.add_argument("--work", required=True, help="directory for the ring images")
    parser.add_argument("--retime-filter", required=True, help="ffmpeg setpts filter applied to RAW before it is made constant-rate")
    args = parser.parse_args()

    start, started, gestures = read_log(args.gestures)
    times, frames = frame_series(args.raw, args.scale)
    solved = anchor(start, started, gestures, times, frames, args)

    small = ring_image(args.ring_px, args.ring_thickness_px, args.edge_px, args.opacity, args.edge_opacity)
    large = ring_image(args.ring_px * args.release_scale, args.ring_thickness_px, args.edge_px, args.opacity, args.edge_opacity)
    small_path, large_path = f"{args.work}/ring-small.png", f"{args.work}/ring-large.png"
    open(small_path, "wb").write(png_bytes(small))
    open(large_path, "wb").write(png_bytes(large))

    length = float(subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", args.raw],
                                  capture_output=True, text=True, check=True).stdout) + 2
    taps = [g for g in gestures if g["kind"] == "tap"]
    fade_in, release = args.fade_in_ms / 1000, args.release_ms / 1000
    quick = 0.05
    # The span of the clip the rings need: from the first finger landing to the end of the last release.
    span_start = min(item["down"] for item in solved) / 1000
    span_end = max(item["up"] / 1000 + (quick + release if g["kind"] == "tap" else release)
                   for item, g in zip(solved, gestures))
    graph = [f"[0:v]{args.retime_filter},fps={args.fps}[b0]",
             f"[1:v]format=rgba,split={len(gestures)}" + "".join(f"[s{i}]" for i in range(len(gestures)))]
    if taps:
        graph.append(f"[2:v]format=rgba,split={len(taps)}" + "".join(f"[l{i}]" for i in range(len(taps))))
    base, big = "b0", 0
    for i, g in enumerate(gestures):
        down, up = solved[i]["down"] / 1000, solved[i]["up"] / 1000
        if g["kind"] == "tap":
            graph.append(f"[s{i}]fade=t=in:st={down:.3f}:d={fade_in:.3f}:alpha=1,fade=t=out:st={up:.3f}:d={quick:.3f}:alpha=1[sf{i}]")
            graph.append(f"[{base}][sf{i}]overlay=x={g['x1']:.0f}-w/2:y={g['y1']:.0f}-h/2:enable='between(t,{down:.3f},{up + quick:.3f})'[t{i}a]")
            graph.append(f"[l{big}]fade=t=in:st={up:.3f}:d={quick:.3f}:alpha=1,fade=t=out:st={up + quick:.3f}:d={release:.3f}:alpha=1[lf{big}]")
            graph.append(f"[t{i}a][lf{big}]overlay=x={g['x1']:.0f}-w/2:y={g['y1']:.0f}-h/2:enable='between(t,{up:.3f},{up + quick + release:.3f})'[b{i + 1}]")
            big += 1
        else:
            graph.append(f"[s{i}]fade=t=in:st={down:.3f}:d={fade_in:.3f}:alpha=1,fade=t=out:st={up:.3f}:d={release:.3f}:alpha=1[sf{i}]")
            span = max(up - down, 0.001)
            x = f"{g['x1']:.0f}+({g['x2']:.0f}-{g['x1']:.0f})*clip((t-{down:.3f})/{span:.3f}\\,0\\,1)-w/2"
            y = f"{g['y1']:.0f}+({g['y2']:.0f}-{g['y1']:.0f})*clip((t-{down:.3f})/{span:.3f}\\,0\\,1)-h/2"
            graph.append(f"[{base}][sf{i}]overlay=x='{x}':y='{y}':enable='between(t,{down:.3f},{up + release:.3f})'[b{i + 1}]")
        base = f"b{i + 1}"
    graph = [line for line in graph if line]
    graph.append(f"[{base}]format=yuv420p[out]")
    command = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-y", "-i", args.raw,
               "-loop", "1", "-framerate", str(args.fps), "-t", f"{length:.3f}", "-i", small_path,
               "-loop", "1", "-framerate", str(args.fps), "-t", f"{length:.3f}", "-i", large_path,
               "-filter_complex", ";".join(graph), "-map", "[out]", "-an", "-c:v", "ffv1", args.out]
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        die("ffmpeg failed: " + result.stderr.strip()[-600:])
    # Two frames past the last release, so the frame the cut ends on has no ring left to be held.
    print(f"SPAN {span_start - fade_in:.3f} {span_end + 2 / args.fps:.3f}")


if __name__ == "__main__":
    main()
