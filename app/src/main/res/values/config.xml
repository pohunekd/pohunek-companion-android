<?xml version="1.0" encoding="utf-8"?>
<!--
  Tunables of the app, read once at start-up into AppConfig. A value that is not valid shows a configuration
  error screen that names the key. Every key is documented here, next to its value.
-->
<resources>
    <!-- Milliseconds to wait for a TCP connection to a daemon to open: an integer greater than 0. -->
    <integer name="connect_timeout_ms">5000</integer>
    <!-- Milliseconds to wait for the response to one request on an open connection: an integer greater than 0. -->
    <integer name="request_timeout_ms">5000</integer>
    <!-- How many times a failed attach is tried from session.attach, the first try included: an integer of at least 1. -->
    <integer name="attach_attempts">2</integer>
    <!-- Milliseconds between two attach tries: an integer greater than 0. -->
    <integer name="attach_retry_delay_ms">500</integer>
    <!-- Seconds between two periodic re-seeds (session.list) that correct what the event stream missed: an integer greater than 0. -->
    <integer name="reseed_interval_secs">60</integer>
    <!-- Milliseconds before the first reconnect to a daemon; the wait doubles per consecutive failure: an integer greater than 0. -->
    <integer name="reconnect_initial_ms">500</integer>
    <!--
      Longest wait in milliseconds between two reconnects, and how long a connection must hold before the failure count resets:
      an integer of at least reconnect_initial_ms.
    -->
    <integer name="reconnect_max_ms">30000</integer>
    <!-- Milliseconds between two daemon.health probes that detect a silently dead connection: an integer greater than 0. -->
    <integer name="liveness_interval_ms">10000</integer>
    <!--
      Milliseconds one probe, connecting included, may take before the connection is declared dead and re-established: an integer
      greater than 0. A dead connection is noticed within liveness_interval_ms + liveness_timeout_ms.
    -->
    <integer name="liveness_timeout_ms">5000</integer>
    <!--
      Milliseconds between two liveness checks of an attached terminal (a daemon.health round trip on the attach control connection): an
      integer greater than 0. A connection that died without a FIN or RST is reported at most attach_liveness_interval_ms + attach_liveness_timeout_ms
      after it died.
    -->
    <integer name="attach_liveness_interval_ms">5000</integer>
    <!-- Milliseconds a liveness check may take before the attach fails with a liveness error: an integer greater than 0. -->
    <integer name="attach_liveness_timeout_ms">3000</integer>
    <!-- Milliseconds before the first re-attach of an open terminal whose attachment broke; the wait doubles per consecutive failure: an integer greater than 0. -->
    <integer name="reattach_initial_ms">500</integer>
    <!--
      Longest wait in milliseconds between two re-attaches, and how long an attach must hold before the failure count resets:
      an integer of at least reattach_initial_ms.
    -->
    <integer name="reattach_max_ms">10000</integer>
    <!--
      Milliseconds an open terminal may stay without an attachment before it stops retrying and shows a final error (a session the
      daemon reports ended or removed stops it at once): an integer greater than 0.
    -->
    <integer name="reattach_give_up_ms">600000</integer>
    <!--
      Seconds a session must stay idle, with no running subagent or background task, before it is shown as Idle instead of Working:
      an integer greater than 0.
    -->
    <integer name="idle_threshold_secs">300</integer>
    <!--
      Records requested per notification.list page when the attention notifications are seeded; the page is halved while the daemon
      reports it as too large, and a page of one that is still too large fails the seed: an integer of at least 1.
    -->
    <integer name="notification_page_size">200</integer>
    <!--
      Size limit in bytes of one log file (files/logs/app.log and the one rotated file app.log.1, so the log never takes more than twice
      this): an integer of at least 4096.
    -->
    <integer name="log_max_bytes">1048576</integer>
</resources>
