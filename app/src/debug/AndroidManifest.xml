<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Exported so `adb shell am start -n dev.pohunek.companion/.debug.TerminalDemoActivity` can open it; debug builds only. -->
        <activity
            android:name=".debug.TerminalDemoActivity"
            android:exported="true"
            android:label="@string/terminal_demo_title"
            android:windowSoftInputMode="adjustResize" />
        <!-- Scratch list for the ui-agent gesture commands. -->
        <activity
            android:name=".debug.GestureDemoActivity"
            android:exported="true"
            android:label="@string/gesture_demo_title" />
        <!-- Only the adb shell holds android.permission.DUMP, so only the host can trigger a clipboard dump. -->
        <receiver
            android:name=".debug.ClipboardDumpReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.pohunek.companion.debug.DUMP_CLIPBOARD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
